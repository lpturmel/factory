{
  "version": 1,
  "name": "factory",
  "backlog": "github",
  "backlog_dir": "factory/backlog",
  "github": {
    "repo": "lpturmel/factory",
    "label": "factory",
    "needs_human_label": "factory:needs-human"
  },
  "merge": "pr",
  "merge_method": "squash",
  "base_branch": "main",
  "remote": "origin",
  "worktree_root": "factory/worktrees",
  "concurrency": 2,
  "max_rounds": 4,
  "gate_timeout_sec": 1800,
  "protected_paths": [
    "factory/checks.sh",
    "factory/config.json",
    "factory/bin/*",
    ".claude/agents/*",
    ".claude/skills/factory/*",
    ".claude/settings.json"
  ],
  "surfaces": {
    "ui": "Changes anything a user sees or touches in the dashboard (ui/src, ui/design, styles, copy, interaction) or the wording of the onboarding interview.",
    "security": "Touches the local reader server (binding, Host checks, allowed paths, SSE), shell or Python scripts that run git/gh, settings.json permissions, input handling or dependencies."
  },
  "models": {
    "aliases": {
      "fable": "claude-fable-5-2",
      "opus": "claude-opus-5-5",
      "sonnet": "claude-sonnet-5-5",
      "haiku": "claude-haiku-5-5"
    },
    "agents": {
      "intake": "fable",
      "spec-writer": "opus",
      "builder": "opus",
      "approver": "opus"
    }
  },
  "reviewers": [
    {
      "name": "code-reviewer",
      "purpose": "Correctness, scope and test integrity of the diff.",
      "model": {
        "low": "haiku",
        "medium": "sonnet",
        "high": "sonnet"
      },
      "when": "always"
    },
    {
      "name": "ui-reviewer",
      "purpose": "Visual fit with the existing dashboard design.",
      "model": "haiku",
      "when": "ui"
    }
  ],
  "prices_usd_per_mtok": {
    "fable": {
      "input": 8.0,
      "output": 40.0,
      "cache_write": 10.0,
      "cache_read": 0.2
    },
    "opus": {
      "input": 4.0,
      "output": 20.0,
      "cache_write": 5.0,
      "cache_read": 0.2
    },
    "sonnet": {
      "input": 2.0,
      "output": 10.0,
      "cache_write": 2.5,
      "cache_read": 0.1
    },
    "haiku": {
      "input": 0.1,
      "output": 0.5,
      "cache_write": 0.125,
      "cache_read": 0.01
    }
  }
}
