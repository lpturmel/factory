{
  "version": 1,
  "name": "{{PROJECT_NAME}}",

  "backlog": "local",
  "backlog_dir": "factory/backlog",
  "github": {
    "repo": null,
    "label": "factory",
    "needs_human_label": "factory:needs-human"
  },

  "merge": "pr",
  "merge_method": "squash",
  "base_branch": "main",
  "remote": "origin",
  "worktree_root": "factory/worktrees",

  "concurrency": 3,
  "max_rounds": 4,
  "gate_timeout_sec": 1800,

  "protected_paths": [
    "factory/checks.sh",
    "factory/config.json",
    "factory/bin/*",
    ".claude/agents/*",
    ".claude/skills/factory/*",
    ".claude/settings.json"
  ],

  "surfaces": {
    "ui": "Changes anything a user sees or touches: layout, styles, components, copy, interaction.",
    "security": "Touches auth, permissions, secrets, input handling, crypto, network exposure or dependencies."
  },

  "models": {
    "aliases": {
      "fable": "claude-fable-5-2",
      "opus": "claude-opus-5-5",
      "sonnet": "claude-sonnet-5-5",
      "haiku": "claude-haiku-5-5"
    },
    "agents": {
      "intake": "fable",
      "spec-writer": "opus",
      "builder": "opus",
      "approver": "opus"
    }
  },

  "reviewers": [
    {
      "name": "code-reviewer",
      "purpose": "Correctness, scope, and test integrity of the diff.",
      "model": {"low": "haiku", "medium": "sonnet", "high": "sonnet"},
      "when": "always"
    },
    {
      "name": "ux-reviewer",
      "purpose": "Whether the change is usable: flows, states, copy, accessibility.",
      "model": "sonnet",
      "when": "ui"
    },
    {
      "name": "ui-reviewer",
      "purpose": "Visual fit with the existing design: spacing, type, color, components.",
      "model": "haiku",
      "when": "ui"
    },
    {
      "name": "security-reviewer",
      "purpose": "Vulnerabilities and unsafe handling of input, secrets and permissions.",
      "model": "opus",
      "when": "security"
    }
  ],

  "prices_usd_per_mtok": {
    "fable":  {"input": 8.0, "output": 40.0, "cache_write": 10.0, "cache_read": 0.20},
    "opus":   {"input": 4.0, "output": 20.0, "cache_write": 5.0, "cache_read": 0.20},
    "sonnet": {"input": 2.0, "output": 10.0, "cache_write": 2.5, "cache_read": 0.10},
    "haiku":  {"input": 0.10, "output": 0.50, "cache_write": 0.125, "cache_read": 0.01}
  }
}
